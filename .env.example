# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI — https://platform.openai.com/api-keys
# Model: gpt-4o-mini
OPENAI_API_KEY=

# Admin password for /admin (portfolio demo only — change this)
ADMIN_PASSWORD=demo123

# Stripe — Dashboard → Developers → API keys (use test keys for dev)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Locally: `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# Production: Dashboard → Developers → Webhooks → endpoint signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Public URL used for Stripe success/cancel redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000
